#!/bin/sh
set -e

if ! command -v node >/dev/null 2>&1; then
  if [ -d "$HOME/.nvm/versions/node" ]; then
    NODE_BIN=$(find "$HOME/.nvm/versions/node" -maxdepth 2 -name bin -type d | sort -V | tail -n 1)
    if [ -n "$NODE_BIN" ]; then
      export PATH="$NODE_BIN:$PATH"
    fi
  fi
fi

echo "Running pre-commit checks..."

# Check non-blank line counts (≤ 200 lines per file)
node scripts/check-line-counts.js

# Check staged files with Biome
npx --no-install biome check --staged --no-errors-on-unmatched

# Run TypeScript type check
npm run typecheck

echo "Pre-commit checks passed successfully."
