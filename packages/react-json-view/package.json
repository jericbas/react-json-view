{
  "name": "react-json-view",
  "version": "1.21.3",
  "type": "module",
  "description": "Interactive JSON viewer component for React 19 with Base16 theming and strict TypeScript",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^16.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mac-s-g/react-json-view.git"
  },
  "keywords": [
    "react",
    "react-19",
    "json",
    "json-view",
    "json-viewer",
    "json-tree",
    "base-16",
    "typescript"
  ],
  "author": "Mac Gainor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mac-s-g/react-json-view/issues"
  },
  "homepage": "https://github.com/mac-s-g/react-json-view#readme"
}
